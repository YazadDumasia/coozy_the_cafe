    "version": "0.2.0",
    "configurations": [
        {
            "name": "coozy_the_cafe",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "coozy_the_cafe (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "coozy_the_cafe (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "coozy_the_cafe (Flutter Chrome)",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "coozy_the_cafe (Flutter Chrome Wasm)",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "request": "launch",
            "type": "dart",
            "args": [
                "--web-renderer",
                "wasm"
            ]
        },
        {
            "name": "coozy_the_cafe (Flutter Chrome Wasm Profile)",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--web-renderer",
                "wasm"
            ]
        }
    ]
}